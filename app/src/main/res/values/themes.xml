<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Sociotask" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="SociotaskAdjusted.Theme.Splash" parent="Theme.SplashScreen">
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.Sociotask.Splash" parent="SociotaskAdjusted.Theme.Splash">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_logo_sociotask</item>
        <item name="postSplashScreenTheme">@style/Theme.Sociotask</item>
    </style>
</resources>